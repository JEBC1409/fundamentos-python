# Tabla de multiplicar

from random import randint

num = int(
    input("ingresa el numero del cual deseas saber la tabla de multiplicacion:  ")
)

for i in range(1, 11):
    mult = i * num
    print(f"{num} x {i} = {mult} ")


# sumar numero con range

total = 0
num = int(input("ingresar numero: "))
for i in range(1, num + 1):
    total += i
print(total)


# Frase contar vocales
frase = input("ingresa una frase")

vocales = 0
for letra in frase:
    if letra in ("aeiouAEIOU"):
        vocales += 1
print(f"tiene un numero de {vocales} vocales")


# Adivinar numero


secreto = randint(1, 20)

for i in range(5):
    numero = int(input("ingresa un numero:"))
    if numero == secreto:
        print("muy bien encontraste el numero")
        break
    elif numero > secreto:
        print("El numero es menor")
    else:
        print("El numero es mayor")
if numero != secreto:
    print("perdiste, sigue intentando")
